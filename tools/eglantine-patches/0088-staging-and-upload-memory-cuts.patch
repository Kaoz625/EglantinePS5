diff --git a/src/video_core/memory_cuts.h b/src/video_core/memory_cuts.h
new file mode 100644
index 0000000000..c03bde51b3
--- /dev/null
+++ b/src/video_core/memory_cuts.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstdlib>
+
+#include "common/common_types.h"
+#include "common/settings.h"
+
+namespace VideoCommon {
+
+/// The Legend of Zelda: Ocarina of Time (Switch 2).
+inline constexpr u64 OcarinaOfTimeSwitch2 = 0x0400486024DEC000ULL;
+
+/// A memory cut in MiB for this session. On a standard PS5 Ocarina of Time (Switch 2) needs about
+/// 1 GiB more than the 12 GiB pool holds (measured 16-17 Nov 2026), so these cuts are on by default
+/// for that title only. Each one has its own switch (env.txt line NAME=<MiB>): a number sets it for
+/// any game, 0 turns it off (the old size). Returns 0 when the cut is off.
+[[nodiscard]] inline u64 MemoryCutMiB(const char* name, u64 ocarina_default) {
+    if (const char* value = std::getenv(name); value != nullptr && *value != '\0') {
+        return std::strtoull(value, nullptr, 10);
+    }
+    return Settings::GetCurrentProgramID() == OcarinaOfTimeSwitch2 ? ocarina_default : 0;
+}
+
+} // namespace VideoCommon
