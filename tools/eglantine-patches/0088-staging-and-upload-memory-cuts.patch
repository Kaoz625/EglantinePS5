+            .usage = usage,
+            .log2_level = 0,
+            .index = unique_ids++,
+            .tick = scheduler.CurrentTick(),
+            .deferred = false,
+        }, buffer_ci.size});
+        return entry.staging.Ref();
+    }
     if (const std::optional<StagingBufferRef> ref = TryGetReservedBuffer(size, usage, deferred)) {
