+// PS5: the two descriptor update queues are heap blocks of 96 MiB and 24 MiB (8 frames of
+// 0x80000 and 0x20000 entries of 24 bytes), and the heap's memory is taken whole from the 12 GiB
+// pool. A quarter of each (24 + 6 MiB): a frame that fills its part waits for the worker and
+// starts its part again (UpdateDescriptorQueue::Acquire). EDEN_NX2_DESC_QUEUE_DIV=1 (2, 8) sets
+// the divisor; 1 is the size the core ships with.
+static size_t DescriptorQueueEntries(size_t entries) {
+    size_t divisor = 4;
+    if (const char* asked = std::getenv("EDEN_NX2_DESC_QUEUE_DIV"); asked && *asked) {
+        const long value = std::strtol(asked, nullptr, 10);
+        if (value >= 1 && value <= 16) divisor = static_cast<size_t>(value);
+    }
+    return entries / divisor;
+}
