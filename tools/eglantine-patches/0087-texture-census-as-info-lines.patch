diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index d747ad55f5..d448141ad3 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -383,6 +383,9 @@ void TextureCache<P>::TickFrame() {
     // Every 600 frames: device memory in use against the collector's thresholds.
     // Skip expensive heap allocation, map construction, and sorting unless debug logging is explicitly enabled.
     static const bool log_tc = std::getenv("EDEN_NX2_TC_LOG") != nullptr;
+    // EDEN_NX2_TC_LOG=2: the largest images and the formats too, as Info lines (the Debug level of
+    // this log class costs the frame rate: 0.6 fps in Ocarina of Time on a PS5).
+    static const bool log_tc_census = log_tc && std::getenv("EDEN_NX2_TC_LOG")[0] == '2';
     static u64 frames{};
     if (log_tc && ++frames % 600 == 0) {
         u64 image_bytes{};
@@ -393,7 +396,7 @@ void TextureCache<P>::TickFrame() {
             const u64 bytes = ImageMemoryBytes(*image);
             image_bytes += bytes;
             ++images;
-            if (debug_stats) {
+            if (debug_stats || log_tc_census) {
                 largest.emplace_back(bytes, image);
                 auto& format = by_format[static_cast<u32>(image->info.format)];
                 format.first += bytes;
@@ -403,10 +406,18 @@ void TextureCache<P>::TickFrame() {
         LOG_INFO(HW_GPU, "Texture cache: device memory {} MiB (expected {} MiB, critical {} MiB), {} images {} MiB",
                  total_used_memory >> 20, expected_memory >> 20, critical_memory >> 20, images,
                  image_bytes >> 20);
-        std::partial_sort(largest.begin(), largest.begin() + std::min<size_t>(12, largest.size()),
+        std::partial_sort(largest.begin(), largest.begin() + std::min<size_t>(log_tc_census ? 24 : 12, largest.size()),
